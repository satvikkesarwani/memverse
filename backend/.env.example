# MEMVERSE backend configuration.
# Copy this file to backend/.env and fill in your values:
#   cp .env.example .env
#
# The backend loads backend/.env automatically at startup. Never commit .env.
# The frontend NEVER receives these values — the key stays server-side.

# --- NVIDIA NIM (live model calls) -------------------------------------------
# Required for the real NVIDIA integration. Get one at https://build.nvidia.com
# When absent, the app runs in clearly-labelled DEMO MODE (deterministic mock).
NVIDIA_API_KEY=

# Optional overrides (defaults shown)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- server behaviour (optional) ---------------------------------------------
# Comma-separated CORS allowlist; default "*" (prototype). Set for production:
# MEMVERSE_CORS_ORIGINS=https://yourdomain.com
# Custom SQLite path (default: backend/data/memverse.db):
# MEMVERSE_DB=./data/memverse.db
